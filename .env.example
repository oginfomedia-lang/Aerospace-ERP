# Aerospace-ERP — required secrets, shared across all 12 backend services.
#
# Setup: copy this file to .env in the repo root, fill in real values, then load
# it via scripts/load-env.sh (Linux/Mac/Git Bash) or scripts/load-env.ps1
# (Windows PowerShell) before starting any service. .env itself is gitignored —
# never commit it.

# HMAC signing secret for JWTs. The SAME value must be set for every service,
# since they all validate tokens issued by auth-service against this secret.
# Generate a new one with:
#   PowerShell:   -join ((1..64) | ForEach-Object { "{0:x}" -f (Get-Random -Maximum 16) })
#   Linux/Mac:    openssl rand -hex 32
JWT_SECRET=

# Postgres password. Must match whatever is actually set on the postgres user —
# changing this here does not change it in the database; run this once against
# your Postgres instance to keep them in sync:
#   ALTER USER postgres WITH PASSWORD 'the-same-value-you-put-below';
DB_PASSWORD=

# Gmail SMTP credentials notification-service uses to send email.
# MAIL_PASSWORD must be a Google "App Password" (Google Account > Security >
# 2-Step Verification > App passwords) — not your normal Gmail login password.
MAIL_USERNAME=
MAIL_PASSWORD=

# Kafka SASL/PLAIN credentials — every service's Kafka producer/consumer
# authenticates with these (see devops/vps/kafka/install-kafka.sh for how the
# broker itself is configured to require them). KAFKA_USERNAME must be
# alphanumeric/underscore only (it becomes part of a JAAS property name).
# Not needed for local dev unless you've also switched your local Kafka to
# require SASL — the plain docker-compose Kafka does not.
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Controls spring.kafka.properties.security.protocol on every service. Leave
# UNSET for local dev — it defaults to PLAINTEXT, matching the plain
# docker-compose Kafka (no SASL). Must be set to SASL_PLAINTEXT on the VPS,
# where install-kafka.sh configures the broker to require SASL/PLAIN auth via
# KAFKA_USERNAME/KAFKA_PASSWORD above.
KAFKA_SECURITY_PROTOCOL=

# Grafana admin password — VPS only (see devops/vps/logging/install-logging.sh),
# not read by any backend service. Replaces Grafana's default admin/admin
# login on first install. Generate the same way as JWT_SECRET above:
#   PowerShell:   -join ((1..32) | ForEach-Object { "{0:x}" -f (Get-Random -Maximum 16) })
#   Linux/Mac:    openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
