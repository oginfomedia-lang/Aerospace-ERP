# Aerospace-ERP — required secrets, shared across all 12 backend services.
#
# Setup: copy this file to .env in the repo root, fill in real values, then load
# it via scripts/load-env.sh (Linux/Mac/Git Bash) or scripts/load-env.ps1
# (Windows PowerShell) before starting any service. .env itself is gitignored —
# never commit it.

# HMAC signing secret for JWTs. The SAME value must be set for every service,
# since they all validate tokens issued by auth-service against this secret.
# Generate a new one with:
#   PowerShell:   -join ((1..64) | ForEach-Object { "{0:x}" -f (Get-Random -Maximum 16) })
#   Linux/Mac:    openssl rand -hex 32
JWT_SECRET=

# Postgres password. Must match whatever is actually set on the postgres user —
# changing this here does not change it in the database; run this once against
# your Postgres instance to keep them in sync:
#   ALTER USER postgres WITH PASSWORD 'the-same-value-you-put-below';
DB_PASSWORD=

# Gmail SMTP credentials notification-service uses to send email.
# MAIL_PASSWORD must be a Google "App Password" (Google Account > Security >
# 2-Step Verification > App passwords) — not your normal Gmail login password.
MAIL_USERNAME=
MAIL_PASSWORD=
