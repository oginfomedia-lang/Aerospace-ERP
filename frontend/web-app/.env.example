# Optional for local dev (falls back to localhost ports). Set these to your real
# deployed backend URLs when building for a non-local environment. CRA only
# bakes REACT_APP_* vars into the build at build time — set them before running
# npm run build, not at runtime.
REACT_APP_AUTH_API_URL=
REACT_APP_INVENTORY_API_URL=
REACT_APP_FINANCE_API_URL=
REACT_APP_SALES_API_URL=
REACT_APP_QA_API_URL=
REACT_APP_PRODUCTION_API_URL=
REACT_APP_NOTIFICATION_API_URL=
REACT_APP_PRODUCTION_RESOURCE_API_URL=
REACT_APP_PROCUREMENT_API_URL=
REACT_APP_WORK_ORDER_API_URL=
