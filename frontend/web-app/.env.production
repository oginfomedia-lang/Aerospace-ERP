GENERATE_SOURCEMAP=false

# Production build target: everything routes through api-gateway (port 8089)
# behind Nginx at the domain below, not directly to each service's own port —
# see devops/vps/README.md for why. Replace ilitecode.com with your real
# subdomain before running `npm run build` for deployment. Path suffixes match
# api-gateway's own route predicates in application.yaml (StripPrefix: 0, so
# these must stay byte-for-byte identical to what each fallback below already
# used locally — only the origin changes).
REACT_APP_AUTH_API_URL=https://ilitecode.com/api/auth
REACT_APP_INVENTORY_API_URL=https://ilitecode.com/api/v1
REACT_APP_FINANCE_API_URL=https://ilitecode.com/api/v1
REACT_APP_SALES_API_URL=https://ilitecode.com/api/v1
REACT_APP_QA_API_URL=https://ilitecode.com/api/v1
REACT_APP_PRODUCTION_API_URL=https://ilitecode.com/api/v1
REACT_APP_NOTIFICATION_API_URL=https://ilitecode.com/api/v1
REACT_APP_PRODUCTION_RESOURCE_API_URL=https://ilitecode.com/api/v1
REACT_APP_PROCUREMENT_API_URL=https://ilitecode.com/api
REACT_APP_WORK_ORDER_API_URL=https://ilitecode.com/api/v1
REACT_APP_NOTIFICATION_WS_URL=https://ilitecode.com/ws
